# Kho dữ liệu. Docker Compose tự tạo địa chỉ kết nối từ hai giá trị dưới đây.
MONGO_ROOT_USER=nichiei_admin
MONGO_ROOT_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
MONGODB_URI=mongodb://nichiei_admin:CHANGE_TO_A_LONG_RANDOM_PASSWORD@mongodb:27017/nichiei_crm?authSource=admin
MONGODB_DB=nichiei_crm

# At least 32 random characters in deployed environments.
CRON_SECRET=
SESSION_SECRET=
APP_URL=https://crm.example.com
DEMO_ADMIN_PASSWORD=
HARAVAN_SHOP=
HARAVAN_ACCESS_TOKEN=
HARAVAN_WEBHOOK_SECRET=

# Sao lưu lên Cloudflare R2 (cấu hình khi chuyển VPS).
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=nichiei-crm-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
